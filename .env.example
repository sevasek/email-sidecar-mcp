# Consumed by email_sidecar/logic.py (fetch/queue/send tools)
EMAIL_ADDRESS=client@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465                       # 465 = implicit SSL (modern), 587 = STARTTLS
EMAIL_SMTP_USE_STARTTLS=                  # set to "1" to force STARTTLS on port 465
EMAIL_SMTP_USE_IMPLICIT_SSL=              # set to "1" to force implicit SSL on port 587
EMAIL_SENDER_NAME=Jane Smith

# Consumed by email_sidecar/email_gate.py (pre-LLM IMAP wake gate — checked
# BEFORE the MCP server/agent is invoked, so it reads its own env var names
# to avoid an orchestrator like Hermes auto-detecting plain EMAIL_* vars)
SIDECAR_EMAIL_IMAP_HOST=imap.gmail.com
SIDECAR_EMAIL_IMAP_PORT=993
SIDECAR_EMAIL_ADDRESS=client@example.com
SIDECAR_EMAIL_PASSWORD=your_app_password

# Consumed by email_sidecar/send_lock.py, email_sidecar/email_gate.py, and
# email_sidecar/logic.py — base directory for the send-lock/audit-log state
# files and for attachments fetch_unread saves to disk (under
# $HERMES_HOME/attachments/<email-id>/). send_reply will only attach files
# whose resolved path stays under that attachments directory.
HERMES_HOME=/opt/data

# Consumed by email_sidecar/logic.py — max decoded size of one inbound
# attachment in bytes (default 10485760 = 10 MiB). Oversized parts are
# reported with an error and not written to disk.
# EMAIL_MAX_ATTACHMENT_BYTES=10485760
